# Copy to .env (gitignored) and fill in. Never commit real keys.
#   cp .env.example .env

# --- LLM (activates the LLM agents and the unguarded experiment modes) ---
# Without a key for the selected provider, the app runs on deterministic fallbacks.
# Provider switch: openai | gemini  (if unset, inferred from whichever key is present)
LLM_PROVIDER=gemini

OPENAI_API_KEY=
GEMINI_API_KEY=

# Max LLM requests per minute (client-side pacing). Default: 4 for gemini (free tier is 5/min),
# unlimited for openai. Raise it if your Gemini plan is paid.
LLM_MAX_RPM=

# Optional model override. Defaults: openai -> gpt-4o-mini, gemini -> gemini-2.5-flash
LLM_MODEL=

# --- Data (optional) ---
# Finnhub news/fundamentals. Free tier is enough to start.
FINNHUB_API_KEY=

# --- Langfuse tracing (planned, P0.3: not read by the code yet) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud: https://cloud.langfuse.com  (or your self-hosted URL)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
